datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model PendingDecision {
  id                 Int                 @id @default(autoincrement())
  signalId           String              @unique
  title              String
  category           String
  expiry             String
  confidence         Float
  sentiment          String
  status             String
  ipfsHash           String?
  evaluations        AgentEvaluation[]
  intelligenceReport IntelligenceReport?
  debateSession      DebateSession?
  createdAt          DateTime            @default(now())
}

model AgentEvaluation {
  id                Int           @id @default(autoincrement())
  pendingDecisionId Int
  pendingDecision   PendingDecision @relation(fields: [pendingDecisionId], references: [id], onDelete: Cascade)
  agentName         String
  vote              String
  confidence        Float
  reasoning         String
  createdAt         DateTime      @default(now())
}


model User {
  address       String   @id
  nickname      String?
  avatar        String?
  totalWinnings Float    @default(0)
  totalVolume   Float    @default(0)
  trades        Trade[]
  createdAt     DateTime @default(now())
}

model Market {
  id           Int      @id
  title        String
  category     String
  totalYesPool Float    @default(0)
  totalNoPool  Float    @default(0)
  resolved     Boolean  @default(false)
  outcome      Boolean?
  trades       Trade[]
  createdAt    DateTime @default(now())
}

model Trade {
  id        String   @id
  marketId  Int
  market    Market   @relation(fields: [marketId], references: [id])
  userAddr  String
  user      User     @relation(fields: [userAddr], references: [address])
  isYes     Boolean
  amount    Float
  createdAt DateTime @default(now())
}

model EvidencePackage {
  id                 Int      @id @default(autoincrement())
  signalId           String   @unique
  normalizedSignal   String   // JSON representation of the NormalizedSignal
  sourceMetadata     String   // Metadata detailing the ingestion origin
  aiReasoningRef     String   // References or descriptors of initial AI reasoning
  confidenceInputs   Float    // Sourced confidence inputs/scores
  createdAt          DateTime @default(now())
}

model IntelligenceReport {
  id                    Int             @id @default(autoincrement())
  pendingDecisionId     Int             @unique
  pendingDecision       PendingDecision @relation(fields: [pendingDecisionId], references: [id], onDelete: Cascade)
  signalId              String          @unique
  summary               String
  supportingEvidence    String          // JSON array represented as string
  contradictingEvidence String          // JSON array represented as string
  confidence            Float
  riskFactors           String          // JSON array represented as string
  reasoning             String
  recommendedDecision   String
  createdAt             DateTime        @default(now())
}

model DebateSession {
  id                Int               @id @default(autoincrement())
  signalId          String            @unique
  pendingDecisionId Int?              @unique
  pendingDecision   PendingDecision?  @relation(fields: [pendingDecisionId], references: [id], onDelete: Cascade)
  status            String            // e.g. "INITIATED", "RISK_REVIEW", "COMPLIANCE_REVIEW", "ANALYST_RESPONSE", "CONCLUDED"
  turns             DebateTurn[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model DebateTurn {
  id               Int           @id @default(autoincrement())
  sessionId        Int
  session          DebateSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  agentName        String        // "AnalystAgent", "RiskAgent", "ComplianceAgent"
  role             String        // "PROPOSER", "REVIEWER", "RESPONDER"
  arguments        String        // JSON string represented as string (string[])
  counterArguments String        // JSON string represented as string (string[])
  questions        String        // JSON string represented as string (string[])
  responses        String        // JSON string represented as string (string[])
  vote             String?       // "APPROVE", "REJECT" (for final position)
  confidence       Float?
  createdAt        DateTime      @default(now())
}
